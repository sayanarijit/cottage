{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "ctg clean -qqq",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "ctg clean -qqq",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
