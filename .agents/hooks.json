{
  "session-start": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "ctg clean -qqq"
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "ctg clean -qqq"
      }
    ]
  },
  "turn-start": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "ctg clean -qqq"
      }
    ]
  },
  "deny-ctg": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/scripts/deny-ctg.py\""
          }
        ]
      }
    ]
  }
}
