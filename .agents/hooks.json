{
  "session-start": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "ctg clean -qqq"
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "ctg clean -qqq"
      }
    ]
  },
  "turn-start": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "ctg clean -qqq"
      }
    ]
  },
  "session-end": {
    "SessionEnd": [
      {
        "type": "command",
        "command": "ctg decrypt -qqq"
      }
    ]
  },
  "deny-ctg": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/deny-ctg.py"
          }
        ]
      }
    ]
  }
}
